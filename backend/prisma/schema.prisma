model RoomMaintenance {
  id BigInt @id @default(autoincrement())
  roomId BigInt @map("room_id")
  startAtUtc DateTime @map("start_at_utc")
  endAtUtc DateTime @map("end_at_utc")
  reason String? @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  room ShopRoom @relation(fields: [roomId], references: [id], onDelete: Restrict)
  calendarBlock ShopCalendarBlock?
  @@index([roomId, startAtUtc, endAtUtc], map: "room_maintenance_window_idx")
  @@map("room_maintenance")
}

// Calendar-only occupation. Resource scopes reuse existing time-off/maintenance;
// only SHOP rows are consumed directly by shared booking availability.
model ShopCalendarBlock {
  id BigInt @id @default(autoincrement())
  shopId BigInt @map("shop_id")
  scope String @db.VarChar(20)
  resourceId BigInt? @map("resource_id")
  purpose String @db.VarChar(30)
  startAtUtc DateTime @map("start_at_utc")
  endAtUtc DateTime @map("end_at_utc")
  timezone String @db.VarChar(100)
  reason String @db.VarChar(500)
  status String @default("ACTIVE") @db.VarChar(20)
  version Int @default(1)
  operatorId BigInt @map("operator_id")
  timeOffId BigInt? @unique @map("time_off_id")
  maintenanceId BigInt? @unique @map("maintenance_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Restrict)
  operator User @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  timeOff TherapistTimeOff? @relation(fields: [timeOffId], references: [id], onDelete: SetNull)
  maintenance RoomMaintenance? @relation(fields: [maintenanceId], references: [id], onDelete: SetNull)
  @@index([shopId, status, startAtUtc, endAtUtc], map: "calendar_blocks_shop_window_idx")
  @@index([shopId, scope, resourceId, status], map: "calendar_blocks_resource_idx")
  @@map("shop_calendar_blocks")
}

// Immutable operation result; intentionally excludes raw reason/contact data.
model CalendarActionReceipt {
