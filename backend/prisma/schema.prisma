// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  MERCHANT
  ADMIN
  STAFF
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum ShopCategory {
  TUINA
  REFLEXOLOGY
  CUPPING
  SCRAPING
  MIXED
}

enum ShopStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum ShopType {
  CERTIFIED
  APPRENTICE
}

enum ServiceCategory {
  MASSAGE
  REFLEXOLOGY
  CUPPING
  SCRAPING
  HEAD_THERAPY
  OTHER
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  REFUNDING
  REFUNDED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
  PARTIALLY_REFUNDED
}

enum ImageType {
  STORE_FRONT
  INTERIOR
  CERTIFICATE
}

enum CertType {
  MASSAGE_LICENSE
  BUSINESS_LICENSE
  INSURANCE
}

model AuthSession {
  id        String @id @default(uuid()) @db.VarChar(36)
  userId    BigInt @map("user_id")
  tokenHash String @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  rotatedTo String? @map("rotated_to") @db.VarChar(36)
  createdAt DateTime @default(now()) @map("created_at")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  pushDevices PushDevice[]
  @@index([userId, expiresAt])
  @@map("auth_sessions")
}

// Tokens are delivery credentials: never include them in public/user projections.
model PushDevice {
  id String @id @default(uuid()) @db.VarChar(36)
  userId BigInt @map("user_id")
  authSessionId String @map("auth_session_id") @db.VarChar(36)
  tokenHash String @unique @map("token_hash") @db.Char(64)
  token String @db.Text
  bindingVersion String @map("binding_version") @db.VarChar(36)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  authSession AuthSession @relation(fields: [authSessionId], references: [id], onDelete: Cascade)
  @@index([userId, updatedAt])
  @@index([authSessionId])
  @@map("push_devices")
}

model PaymentRecord {
  id String @id @default(uuid()) @db.VarChar(36)
  bookingId BigInt @unique @map("booking_id")
  provider String @db.VarChar(20)
  providerBinding Json? @map("provider_binding")
  providerPaymentId String? @unique @map("provider_payment_id") @db.VarChar(255)
  providerOrderId String? @unique @map("provider_order_id") @db.VarChar(255)
  checkoutUrl String? @map("checkout_url") @db.VarChar(2048)
  idempotencyKey String @unique @map("idempotency_key") @db.VarChar(100)
  amountCents Int @map("amount_cents")
  currency String @db.VarChar(3)
  status String @default("CREATED") @db.VarChar(20)
  refundedCents Int @default(0) @map("refunded_cents")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  booking Booking @relation(fields: [bookingId], references: [id])
  refunds RefundRequest[]
  @@map("payment_records")
}

model PaymentEvent {
  id String @id @default(uuid()) @db.VarChar(36)
  provider String @db.VarChar(20)
  eventId String @map("event_id") @db.VarChar(255)
  payloadHash String @map("payload_hash") @db.VarChar(64)
  processedAt DateTime @default(now()) @map("processed_at")
  @@unique([provider, eventId])
  @@map("payment_events")
}

model RefundRequest {
  id String @id @default(uuid()) @db.VarChar(36)
  bookingId BigInt @map("booking_id")
  paymentRecordId String @map("payment_record_id") @db.VarChar(36)
  idempotencyKey String @unique @map("idempotency_key") @db.VarChar(100)
  amountCents Int @map("amount_cents")
  status String @default("PENDING") @db.VarChar(20)
  providerRefundId String? @unique @map("provider_refund_id") @db.VarChar(255)
  failureCode String? @map("failure_code") @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  booking Booking @relation(fields: [bookingId], references: [id])
  payment PaymentRecord @relation(fields: [paymentRecordId], references: [id])
  afterSalesCase AfterSalesCase?
  @@index([bookingId, status])
  @@map("refund_requests")
}

model User {
  mediaAssets MediaAsset[] @relation("MediaUploader")
  id            BigInt      @id @default(autoincrement())
  loginName     String?     @unique @map("login_name") @db.VarChar(64)
  phone         String?     @unique @db.VarChar(20)
  email         String?     @unique @db.VarChar(255)
  emailVerifiedAt DateTime? @map("email_verified_at")
  passwordHash  String?     @map("password_hash") @db.VarChar(255)
  name          String?     @db.VarChar(100)
  avatarUrl     String?     @map("avatar_url") @db.VarChar(500)
  role          Role        @default(CUSTOMER)
  status        UserStatus  @default(ACTIVE)
  appleId       String?     @unique @map("apple_id") @db.VarChar(255)
  googleId      String?     @unique @map("google_id") @db.VarChar(255)
  lastLoginAt   DateTime?   @map("last_login_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  deletedAt     DateTime?   @map("deleted_at")

  bookings        Booking[]
  reviews         Review[]
  favorites       UserFavorite[]
  ownedShops      Shop[]           @relation("ShopOwner")
  reviewedShops   Shop[]           @relation("ShopReviewer")
  auditLogs       AuditLog[]
  merchantProfiles MerchantProfile[]
  sensitiveHitLogs SensitiveHitLog[]
  userCoupons     UserCoupon[]
  authSessions    AuthSession[]
  pushDevices     PushDevice[]
  giftOrders      GiftCardOrder[]
  giftRights      GiftCardEntitlement[]
  giftSaleEntries GiftCardSaleEntry[]
  notificationJobs NotificationOutbox[]
  notifications UserNotification[]
  notificationPreference NotificationPreference?
  giftRedemptions GiftCardRedemption[]
  afterSalesAsCustomer AfterSalesCase[] @relation("AfterSalesCustomer")
  afterSalesAssigned AfterSalesCase[] @relation("AfterSalesAssigned")
  afterSalesEvents AfterSalesEvent[] @relation("AfterSalesActor")
  settlementEntries BookingSettlementEntry[]
  staffGrants ShopStaffGrant[] @relation("StaffUser")
  createdStaffGrants ShopStaffGrant[] @relation("StaffGrantCreator")
  providerIdentities AuthProviderIdentity[]
  shopLoginBinding ShopLoginBinding? @relation("ShopLoginAccount")
  createdShopLoginBindings ShopLoginBinding[] @relation("ShopLoginBindingCreator")
  createdShopAccountGrants ShopAccountGrant[] @relation("AccountGrantCreator")
  updatedShopAccountGrants ShopAccountGrant[] @relation("AccountGrantUpdater")
  revokedShopAccountGrants ShopAccountGrant[] @relation("AccountGrantRevoker")
  accountProvisionActions AccountProvisionOperation[] @relation("AccountProvisionActor")
  accountProvisionResults AccountProvisionOperation[] @relation("AccountProvisionUser")
  calendarBlocks ShopCalendarBlock[]
  calendarActionReceipts CalendarActionReceipt[]
  assistedBookings Booking[] @relation("BookingAssistedBy")
  guestBookingOperations GuestBookingOperation[]

  @@index([phone])
  @@index([role, status])
  @@map("users")
}

model Shop {
  mediaAssets MediaAsset[]
  id             BigInt        @id @default(autoincrement())
  ownerId        BigInt        @map("owner_id")
  name           String        @db.VarChar(200)
  shortName      String?       @unique @map("short_name") @db.VarChar(100)
  timezone       String?       @db.VarChar(100)
  studioProfile  Json?         @map("studio_profile")
  nameEn         String?       @map("name_en") @db.VarChar(200)
  description    String?       @db.Text
  phone          String        @db.VarChar(20)
  address        String        @db.VarChar(500)
  city           String        @db.VarChar(100)
  state          String        @db.VarChar(50)
  zipCode        String        @map("zip_code") @db.VarChar(10)
  latitude       Decimal       @db.Decimal(10, 7)
  longitude      Decimal       @db.Decimal(10, 7)
  category       ShopCategory
  status         ShopStatus    @default(PENDING)
  reviewComment  String?       @map("review_comment") @db.Text
  reviewedAt     DateTime?     @map("reviewed_at")
  reviewedBy     BigInt?       @map("reviewed_by")
  shopType       ShopType      @default(APPRENTICE) @map("shop_type")
  businessHours  Json?         @map("business_hours")
  avgRating      Decimal       @default(0.00) @map("avg_rating") @db.Decimal(3, 2)
  reviewCount    Int           @default(0) @map("review_count")
  bookingCount   Int           @default(0) @map("booking_count")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  deletedAt      DateTime?     @map("deleted_at")

  staffGrants ShopStaffGrant[]
  orderEmailSetting ShopOrderEmailSetting?
  loginBinding ShopLoginBinding?
  outgoingAccountGrants ShopAccountGrant[] @relation("AccountGrantSource")
  incomingAccountGrants ShopAccountGrant[] @relation("AccountGrantTarget")
  accountProvisionOperations AccountProvisionOperation[]
  owner        User              @relation("ShopOwner", fields: [ownerId], references: [id])
  reviewer     User?             @relation("ShopReviewer", fields: [reviewedBy], references: [id])
  therapists   Therapist[]
  shopServices ShopService[]
  shopImages   ShopImage[]
  certificates ShopCertificate[]
  bookings     Booking[]
  reviews      Review[]
  favorites    UserFavorite[]
  coupons      Coupon[]
  giftProducts GiftCardProduct[]
  giftOrders   GiftCardOrder[]
  giftRights   GiftCardEntitlement[]
  giftSalesPolicy ShopGiftSalesPolicy?
  afterSalesCases AfterSalesCase[]
  rooms ShopRoom[]
  resourceLocks BookingResourceLock[]
  merchantProfile MerchantProfile?
  aliases ShopAlias[]
  calendarBlocks ShopCalendarBlock[]
  calendarActionReceipts CalendarActionReceipt[]
  guestBookingOperations GuestBookingOperation[]

  @@index([status])
  @@index([latitude, longitude])
  @@index([city, state])
  @@index([name])
  @@map("shops")
}

// Private notification destination. Never merge this relation into public shop profiles.
model ShopOrderEmailSetting {
  shopId BigInt @id @map("shop_id")
  revision Int @default(0)
  enabled Boolean @default(true)
  recipientEmail String? @map("recipient_email") @db.VarChar(255)
  recipientVerifiedAt DateTime? @map("recipient_verified_at") @db.DateTime(3)
  challengeId String? @unique @map("challenge_id") @db.VarChar(36)
  pendingEmail String? @map("pending_email") @db.VarChar(255)
  codeHash String? @map("code_hash") @db.Char(64)
  pendingExpiresAt DateTime? @map("pending_expires_at") @db.DateTime(3)
  attempts Int @default(0)
  deliveryState String? @map("delivery_state") @db.VarChar(20)
  consumedAt DateTime? @map("consumed_at") @db.DateTime(3)
  lastRequestedAt DateTime? @map("last_requested_at") @db.DateTime(3)
  windowStart DateTime? @map("window_start") @db.DateTime(3)
  sendCount Int @default(0) @map("send_count")
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@map("shop_order_email_settings")
}

model ShopAlias {
  id BigInt @id @default(autoincrement())
  shopId BigInt @map("shop_id")
  kind String @db.VarChar(20)
  source String @db.VarChar(40)
  value String @db.VarChar(100)
  isActive Boolean @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  shop Shop @relation(fields:[shopId],references:[id],onDelete:Restrict,onUpdate:Restrict)
  @@unique([kind,source,value],map:"shop_aliases_kind_source_value_key")
  @@index([shopId,isActive],map:"shop_aliases_shop_active_idx")
  @@map("shop_aliases")
}

// Operational evidence only: physical receipts never credit an online payout balance.
model BookingSettlementEntry {
  id String @id @default(uuid()) @db.VarChar(36)
  bookingId BigInt @map("booking_id")
  operatorId BigInt? @map("operator_id")
  kind String @db.VarChar(20)
  amountCents Int @map("amount_cents")
  currency String @db.VarChar(3)
  method String? @db.VarChar(30)
  requestKey String @map("request_key") @db.VarChar(80)
  requestHash String @map("request_hash") @db.Char(64)
  referenceEntryId String? @map("reference_entry_id") @db.VarChar(36)
  occurredAt DateTime @map("occurred_at")
  reason String @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")
  booking Booking @relation(fields:[bookingId],references:[id],onDelete:Restrict,onUpdate:Restrict)
  operator User? @relation(fields:[operatorId],references:[id],onDelete:Restrict,onUpdate:Restrict)
  referenceEntry BookingSettlementEntry? @relation("SettlementCorrections",fields:[referenceEntryId],references:[id],onDelete:Restrict,onUpdate:Restrict)
  corrections BookingSettlementEntry[] @relation("SettlementCorrections")
  @@unique([bookingId,requestKey],map:"booking_settlements_booking_request_key")
  @@index([bookingId,createdAt],map:"booking_settlements_booking_created_idx")
  @@index([referenceEntryId],map:"booking_settlements_reference_idx")
  @@map("booking_settlement_entries")
}

model Region {
  id BigInt @id @default(autoincrement())
  kind String @db.VarChar(10)
  parentId BigInt? @map("parent_id")
  abbr String @default("") @db.VarChar(10)
  english String @db.VarChar(200)
  chinese String @db.VarChar(200)
  status String @default("启用") @db.VarChar(10)
  sort Int @default(100)
  zipCode String? @map("zip_code") @db.VarChar(30)
  updatedAt DateTime @updatedAt @map("updated_at")
  parent Region? @relation("RegionTree", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  children Region[] @relation("RegionTree")
  @@index([kind, parentId])
  @@map("regions")
}

model ShopService {
  id           BigInt           @id @default(autoincrement())
  shopId       BigInt           @map("shop_id")
  name         String           @db.VarChar(200)
  nameEn       String?          @map("name_en") @db.VarChar(200)
  category     ServiceCategory
  durationKind String @default("TIMED") @map("duration_kind") @db.VarChar(20)
  durationMin  Int              @map("duration_min")
  priceCents   Int              @map("price_cents")
  priceBasis   String           @default("PER_BOOKING") @map("price_basis") @db.VarChar(20)
  participantCount Int @default(1) @map("participant_count")
  requiredStaffCount Int @default(1) @map("required_staff_count")
  requiredRoomType String? @map("required_room_type") @db.VarChar(20)
  staffBufferMin Int @default(0) @map("staff_buffer_min")
  roomBufferMin Int @default(0) @map("room_buffer_min")
  description  String?          @db.Text
  isActive     Boolean          @default(true) @map("is_active")
  sortOrder    Int              @default(0) @map("sort_order")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  shop               Shop                @relation(fields: [shopId], references: [id])
  therapistServices  TherapistService[]
  bookings           Booking[]
  variants ShopServiceVariant[]
  bookingItems BookingItem[]
  addOns ShopServiceAddOn[]

  @@index([shopId, isActive])
  @@index([category])
  @@map("shop_services")
}

model Therapist {
  id         BigInt   @id @default(autoincrement())
  shopId     BigInt   @map("shop_id")
  name       String   @db.VarChar(100)
  avatarUrl  String?  @map("avatar_url") @db.VarChar(500)
  title      String?  @db.VarChar(100)
  bio        String?  @db.Text
  yearsExp   Int      @default(0) @map("years_exp")
  gender     String?  @db.VarChar(10)
  isActive   Boolean  @default(true) @map("is_active")
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  shop               Shop                @relation(fields: [shopId], references: [id])
  therapistServices  TherapistService[]
  bookings           Booking[]
  assignedItems      BookingItem[] @relation("AssignedItemTherapist")
  scheduleMode String @default("SHOP") @map("schedule_mode") @db.VarChar(20)
  shifts TherapistShift[]
  timeOff TherapistTimeOff[]

  @@index([shopId, isActive])
  @@map("therapists")
}

model TherapistService {
  therapistId BigInt @map("therapist_id")
  serviceId   BigInt @map("service_id")

  therapist Therapist   @relation(fields: [therapistId], references: [id])
  service   ShopService @relation(fields: [serviceId], references: [id])

  @@id([therapistId, serviceId])
  @@map("therapist_services")
}

model Booking {
  id                BigInt         @id @default(autoincrement())
  bookingNo         String         @unique @map("booking_no") @db.VarChar(30)
  userId            BigInt?        @map("user_id")
  shopId            BigInt         @map("shop_id")
  bookingSource     String         @default("ONLINE") @map("booking_source") @db.VarChar(30)
  assistedById      BigInt?        @map("assisted_by_id")
  guestSource       String?        @map("guest_source") @db.VarChar(20)
  contactName       String?        @map("contact_name") @db.VarChar(100)
  contactPhone      String?        @map("contact_phone") @db.VarChar(16)
  contactEmail      String?        @map("contact_email") @db.VarChar(255)
  contactVersion    Int?           @map("contact_version")
  contactSource     String?        @map("contact_source") @db.VarChar(40)
  contactEmailVerifiedAt DateTime? @map("contact_email_verified_at")
  therapistId       BigInt?        @map("therapist_id")
  serviceId         BigInt         @map("service_id")
  bookingDate       DateTime       @map("booking_date")
  bookingTimezone   String?        @map("booking_timezone") @db.VarChar(80)
  startTime         DateTime       @map("start_time")
  endTime           DateTime       @map("end_time")
  durationMin       Int            @map("duration_min")
  priceCents        Int            @map("price_cents")
  discountCents     Int            @default(0) @map("discount_cents")
  platformFeeCents  Int            @default(0) @map("platform_fee_cents")
  tipCents          Int            @default(0) @map("tip_cents")
  participantCountSnapshot Int @default(1) @map("participant_count_snapshot")
  requiredStaffCountSnapshot Int @default(1) @map("required_staff_count_snapshot")
  reservationKind   String         @default("SINGLE") @map("reservation_kind") @db.VarChar(20)
  therapistSelectionMode String @default("LEGACY_UNKNOWN") @map("therapist_selection_mode") @db.VarChar(20)
  requestedTherapistIds Json? @map("requested_therapist_ids")
  totalCents        Int            @default(0) @map("total_cents")
  paidCents         Int            @default(0) @map("paid_cents")
  refundedCents     Int            @default(0) @map("refunded_cents")
  currency          String         @default("usd") @db.VarChar(3)
  couponId          BigInt?        @map("coupon_id")
  status            BookingStatus  @default(PENDING)
  cancelReason      String?        @map("cancel_reason") @db.VarChar(500)
  paymentId         String?        @map("payment_id") @db.VarChar(255)
  paymentStatus     PaymentStatus  @default(UNPAID) @map("payment_status")
  paymentMode       String         @default("ONLINE") @map("payment_mode") @db.VarChar(20)
  requestKey String? @map("request_key") @db.VarChar(100)
  requestHash String? @map("request_hash") @db.Char(64)
  holdExpiresAt DateTime? @map("hold_expires_at")
  notes             String?        @db.Text
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  deletedAt         DateTime?      @map("deleted_at")
  // Customer list preference only; never a merchant/financial lifecycle delete.
  customerHiddenAt  DateTime?      @map("customer_hidden_at")

  user      User?       @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  assistedBy User?      @relation("BookingAssistedBy", fields: [assistedById], references: [id], onDelete: Restrict)
  shop      Shop        @relation(fields: [shopId], references: [id])
  therapist Therapist?  @relation(fields: [therapistId], references: [id])
  service   ShopService @relation(fields: [serviceId], references: [id])
  coupon    Coupon?     @relation(fields: [couponId], references: [id])
  userCoupon UserCoupon?
  review    Review?
  payments PaymentRecord[]
  refunds RefundRequest[]
  items BookingItem[]
  addOns BookingAddOn[]
  afterSalesCases AfterSalesCase[]
  settlementEntries BookingSettlementEntry[]
  resourceLocks BookingResourceLock[]
  guestOperation GuestBookingOperation?

  @@unique([userId, requestKey], map: "bookings_user_request_key")
  @@index([shopId, assistedById, requestKey], map: "bookings_assisted_request_key")
  @@index([status, paymentStatus, holdExpiresAt], map: "bookings_hold_expiry_idx")
  @@index([userId, status])
  @@index([shopId, status])
  @@index([bookingDate])
  @@index([bookingNo])
  @@index([paymentStatus])
  @@index([couponId])
  @@map("bookings")
}

// Guest creation result/fence is scoped to the current authorized operator.
// Contact and command bodies never appear in this table.
model GuestBookingOperation {
  id BigInt @id @default(autoincrement())
  shopId BigInt @map("shop_id")
  operatorId BigInt @map("operator_id")
  requestKey String @map("request_key") @db.VarChar(36)
  requestHash String @map("request_hash") @db.Char(64)
  outcome String @db.VarChar(20)
  bookingId BigInt? @unique @map("booking_id")
  bookingNo String? @map("booking_no") @db.VarChar(30)
  createdAt DateTime @default(now()) @map("created_at")
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Restrict)
  operator User @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  @@unique([shopId, operatorId, requestKey], map: "guest_booking_operations_actor_key")
  @@map("guest_booking_operations")
}

model Review {
  id           BigInt   @id @default(autoincrement())
  bookingId    BigInt   @unique @map("booking_id")
  userId       BigInt   @map("user_id")
  shopId       BigInt   @map("shop_id")
  rating       Int
  content      String?  @db.Text
  images       Json?
  isPublic     Boolean  @default(true) @map("is_public")
  isFlagged    Boolean  @default(false) @map("is_flagged")
  replyContent String?  @map("reply_content") @db.Text
  repliedAt    DateTime? @map("replied_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  booking Booking @relation(fields: [bookingId], references: [id])
  user    User    @relation(fields: [userId], references: [id])
  shop    Shop    @relation(fields: [shopId], references: [id])

  @@index([shopId, isPublic])
  @@index([userId])
  @@map("reviews")
}

model UserFavorite {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  shopId    BigInt   @map("shop_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([userId, shopId])
  @@index([userId])
  @@index([shopId])
  @@map("user_favorites")
}

model ShopImage {
  id        BigInt    @id @default(autoincrement())
  shopId    BigInt    @map("shop_id")
  imageUrl  String    @map("image_url") @db.VarChar(500)
  imageType ImageType @default(STORE_FRONT) @map("image_type")
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at")

  shop Shop @relation(fields: [shopId], references: [id])

  @@index([shopId])
  @@map("shop_images")
}

model ShopCertificate {
