  @@map("shop_certificates")
}

model MerchantProfile {
  id                BigInt   @id @default(autoincrement())
  userId            BigInt   @map("user_id")
  shopId            BigInt   @unique @map("shop_id")
  stripeAccountId   String?  @map("stripe_account_id") @db.VarChar(255)
