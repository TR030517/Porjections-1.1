enum CouponType {
  FIXED_AMOUNT
  PERCENT
}

enum CouponStatus {
  DRAFT
  ACTIVE
  PAUSED
  EXPIRED
}

enum UserCouponStatus {
  UNUSED
  USED
  EXPIRED
}

model Coupon {
  id             BigInt       @id @default(autoincrement())
  shopId         BigInt?      @map("shop_id")           // null = platform-wide coupon
  title          String       @db.VarChar(200)
  description    String?      @db.VarChar(500)
  type           CouponType
  value          Int                                     // fixed cents or percent value
  minSpendCents  Int          @default(0) @map("min_spend_cents")
  totalQuantity  Int          @default(0) @map("total_quantity")     // 0 = unlimited
  claimedCount   Int          @default(0) @map("claimed_count")
  usedCount      Int          @default(0) @map("used_count")
  perUserLimit   Int          @default(1) @map("per_user_limit")
  validFrom      DateTime     @default(now()) @map("valid_from")
  validUntil     DateTime?    @map("valid_until")
  status         CouponStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  deletedAt      DateTime?    @map("deleted_at")

  shop        Shop?         @relation(fields: [shopId], references: [id])
  bookings    Booking[]
  userCoupons UserCoupon[]

  @@index([shopId, status])
  @@index([status, validFrom, validUntil])
  @@index([claimedCount])
  @@map("coupons")
}

model UserCoupon {
  id        BigInt           @id @default(autoincrement())
  userId    BigInt           @map("user_id")
  couponId  BigInt           @map("coupon_id")
  status    UserCouponStatus @default(UNUSED)
  claimedAt DateTime         @default(now()) @map("claimed_at")
  usedAt    DateTime?        @map("used_at")
  expiredAt DateTime?        @map("expired_at")
  bookingId BigInt?          @unique @map("booking_id")

  user    User     @relation(fields: [userId], references: [id])
  coupon  Coupon   @relation(fields: [couponId], references: [id])
  booking Booking? @relation(fields: [bookingId], references: [id])

  @@unique([userId, couponId])
  @@index([userId, status])
  @@index([couponId])
  @@map("user_coupons")
}

// Product, sale, entitlement and redemption are separate records. No card data is stored.
model GiftCardProduct {
  id BigInt @id @default(autoincrement())
  shopId BigInt @map("shop_id")
  title String @db.VarChar(200)
  description String? @db.Text
  priceCents Int @map("price_cents")
  useTimes Int @default(1) @map("use_times")
  expireDays Int @default(365) @map("expire_days")
  status String @default("DRAFT") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  shop Shop @relation(fields: [shopId], references: [id])
  orders GiftCardOrder[]
  rights GiftCardEntitlement[]
  @@index([shopId, status])
  @@map("gift_card_products")
}

model GiftCardOrder {
  id BigInt @id @default(autoincrement())
  orderNo String @unique @map("order_no") @db.VarChar(40)
  userId BigInt @map("user_id")
  shopId BigInt @map("shop_id")
  productId BigInt @map("product_id")
  amountCents Int @map("amount_cents")
  paidCents Int @default(0) @map("paid_cents")
  refundedCents Int @default(0) @map("refunded_cents")
  paymentMethod String @default("LEGACY") @map("payment_method") @db.VarChar(20)
  status String @default("PENDING") @db.VarChar(20)
  providerPaymentId String? @unique @map("provider_payment_id") @db.VarChar(255)
  requestKey String? @map("request_key") @db.VarChar(100)
  requestHash String? @map("request_hash") @db.Char(64)
  productTitleSnapshot String? @map("product_title_snapshot") @db.VarChar(200)
  useTimesSnapshot Int? @map("use_times_snapshot")
  expireDaysSnapshot Int? @map("expire_days_snapshot")
  currency String @default("usd") @db.VarChar(3)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user User @relation(fields: [userId], references: [id])
  shop Shop @relation(fields: [shopId], references: [id])
  product GiftCardProduct @relation(fields: [productId], references: [id])
  rights GiftCardEntitlement[]
  saleEntries GiftCardSaleEntry[]
  @@index([shopId, createdAt])
  @@index([userId, status])
  @@unique([userId, requestKey], map: "gift_orders_user_request_key")
  @@map("gift_card_orders")
}

model GiftCardEntitlement {
  id String @id @default(uuid()) @db.VarChar(36)
  userId BigInt @map("user_id")
  shopId BigInt @map("shop_id")
  productId BigInt @map("product_id")
  orderId BigInt? @map("order_id")
  purchaseKey String? @unique @map("purchase_key") @db.Char(64)
  tokenHash String @unique @map("token_hash") @db.VarChar(64)
  totalUses Int @map("total_uses")
  remainingUses Int @map("remaining_uses")
  expiresAt DateTime @map("expires_at")
  status String @default("ACTIVE") @db.VarChar(20)
  grantReason String? @map("grant_reason") @db.VarChar(500)
  source String @default("LEGACY") @db.VarChar(20)
  productTitleSnapshot String? @map("product_title_snapshot") @db.VarChar(200)
  grantKey String? @unique @map("grant_key") @db.Char(64)
  grantHash String? @map("grant_hash") @db.Char(64)
  grantedById BigInt? @map("granted_by_id")
  voucherExpiresAt DateTime? @map("voucher_expires_at")
  voucherUses Int? @map("voucher_uses")
  voidedAt DateTime? @map("voided_at")
  voidedById BigInt? @map("voided_by_id")
  voidReason String? @map("void_reason") @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")
  user User @relation(fields: [userId], references: [id])
  shop Shop @relation(fields: [shopId], references: [id])
  product GiftCardProduct @relation(fields: [productId], references: [id])
  order GiftCardOrder? @relation(fields: [orderId], references: [id])
  redemptions GiftCardRedemption[]
  @@index([userId, status])
  @@index([shopId])
  @@map("gift_card_entitlements")
}

model GiftCardRedemption {
  id String @id @default(uuid()) @db.VarChar(36)
  entitlementId String @map("entitlement_id") @db.VarChar(36)
  operatorId BigInt @map("operator_id")
  idempotencyKey String @unique @map("idempotency_key") @db.VarChar(100)
  usedUses Int @map("used_uses")
  shopId BigInt? @map("shop_id")
  requestHash String? @map("request_hash") @db.Char(64)
  createdAt DateTime @default(now()) @map("created_at")
  entitlement GiftCardEntitlement @relation(fields: [entitlementId], references: [id])
  operator User @relation(fields: [operatorId], references: [id])
  @@index([entitlementId, createdAt])
  @@map("gift_card_redemptions")
}

// A support case records decisions; only a verified RefundRequest records money movement.
model AfterSalesCase {
  id BigInt @id @default(autoincrement())
  bookingId BigInt @map("booking_id")
  shopId BigInt @map("shop_id")
  customerId BigInt @map("customer_id")
  activeBookingId BigInt? @unique @map("active_booking_id")
  type String @db.VarChar(20)
  status String @default("OPEN") @db.VarChar(20)
  reason String @db.Text
  requestedAmountCents Int? @map("requested_amount_cents")
  currency String @db.VarChar(3)
  assignedToId BigInt? @map("assigned_to_id")
  acceptedAt DateTime? @map("accepted_at")
  version Int @default(1)
  refundKey String? @unique @map("refund_key") @db.VarChar(80)
  refundState String @default("NONE") @map("refund_state") @db.VarChar(20)
  refundRequestId String? @unique @map("refund_request_id") @db.VarChar(36)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  closedAt DateTime? @map("closed_at")
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Restrict)
  customer User @relation("AfterSalesCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  assignedTo User? @relation("AfterSalesAssigned", fields: [assignedToId], references: [id], onDelete: Restrict)
  refundRequest RefundRequest? @relation(fields: [refundRequestId], references: [id], onDelete: Restrict)
  events AfterSalesEvent[]
  @@index([shopId, status, createdAt])
  @@index([customerId, status, createdAt])
  @@index([bookingId])
  @@map("after_sales_cases")
}

model AfterSalesEvent {
  id BigInt @id @default(autoincrement())
  caseId BigInt @map("case_id")
  actorId BigInt @map("actor_id")
  kind String @db.VarChar(40)
  visibility String @db.VarChar(10)
  content String? @db.Text
  fromStatus String? @map("from_status") @db.VarChar(20)
  toStatus String? @map("to_status") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")
  case AfterSalesCase @relation(fields: [caseId], references: [id], onDelete: Restrict)
  actor User @relation("AfterSalesActor", fields: [actorId], references: [id], onDelete: Restrict)
  @@index([caseId, id])
  @@map("after_sales_events")
}

// Booking resources are additive: no historical booking or financial record is rewritten.
model ShopServiceVariant {
  id BigInt @id @default(autoincrement())
  serviceId BigInt @map("service_id")
  name String @db.VarChar(100)
  durationMin Int @map("duration_min")
  priceCents Int @map("price_cents")
  priceBasis String @default("PER_BOOKING") @map("price_basis") @db.VarChar(20)
  currency String @default("usd") @db.VarChar(3)
  isActive Boolean @default(true) @map("is_active")
  sortOrder Int @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  service ShopService @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  bookingItems BookingItem[]
  @@index([serviceId, isActive, sortOrder], map: "service_variants_service_active_sort_idx")
  @@map("shop_service_variants")
}

// Optional paid extras belong to an existing primary service. They never carry
// appointment duration or independent staff/room allocation.
model ShopServiceAddOn {
  id BigInt @id @default(autoincrement())
  serviceId BigInt @map("service_id")
  name String @db.VarChar(100)
  description String? @db.VarChar(1000)
  priceCents Int @map("price_cents")
  currency String @default("usd") @db.VarChar(3)
  isActive Boolean @default(false) @map("is_active")
  sortOrder Int @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  service ShopService @relation(fields: [serviceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  bookingAddOns BookingAddOn[]
  @@index([serviceId, isActive, sortOrder], map: "service_addons_service_active_sort_idx")
  @@map("shop_service_addons")
}

// Immutable quoted extras attached to a specific primary participant/segment.
// Later configuration changes never rewrite these historical prices or names.
model BookingAddOn {
  id BigInt @id @default(autoincrement())
  bookingId BigInt @map("booking_id")
  bookingItemId BigInt @map("booking_item_id")
  sourceAddOnId BigInt @map("source_addon_id")
  participantIndex Int @map("participant_index")
  sequence Int
  nameSnapshot String @map("name_snapshot") @db.VarChar(100)
  unitPriceCentsSnapshot Int @map("unit_price_cents_snapshot")
  quantity Int @default(1)
  lineTotalCentsSnapshot Int @map("line_total_cents_snapshot")
  currency String @db.VarChar(3)
  createdAt DateTime @default(now()) @map("created_at")
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  bookingItem BookingItem @relation(fields: [bookingItemId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sourceAddOn ShopServiceAddOn @relation(fields: [sourceAddOnId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@unique([bookingItemId, sourceAddOnId], map: "booking_addons_item_source_key")
  @@index([bookingId], map: "booking_addons_booking_idx")
  @@index([sourceAddOnId], map: "booking_addons_source_idx")
  @@map("booking_addons")
}

model TherapistShift {
  id BigInt @id @default(autoincrement())
  therapistId BigInt @map("therapist_id")
  weekday Int
  startMin Int @map("start_min")
  endMin Int @map("end_min")
  isActive Boolean @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  therapist Therapist @relation(fields: [therapistId], references: [id], onDelete: Restrict)
  @@index([therapistId, weekday, isActive], map: "therapist_shifts_day_active_idx")
  @@map("therapist_shifts")
}

model TherapistTimeOff {
  id BigInt @id @default(autoincrement())
  therapistId BigInt @map("therapist_id")
  startAtUtc DateTime @map("start_at_utc")
  endAtUtc DateTime @map("end_at_utc")
  reason String? @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  therapist Therapist @relation(fields: [therapistId], references: [id], onDelete: Restrict)
