  blockId BigInt? @map("block_id")
  blockVersion Int? @map("block_version")
  closedDate String? @map("closed_date") @db.VarChar(10)
  createdAt DateTime @default(now()) @map("created_at")
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Restrict)
  operator User @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  @@unique([shopId, operatorId, requestKey], map: "calendar_action_receipts_actor_key")
  @@map("calendar_action_receipts")
}

model BookingItem {
  id BigInt @id @default(autoincrement())
  bookingId BigInt @map("booking_id")
  serviceId BigInt @map("service_id")
  variantId BigInt? @map("variant_id")
  participantIndex Int @map("participant_index")
  sequence Int @default(1)
  offsetMin Int @default(0) @map("offset_min")
  priceBasisSnapshot String @default("PER_PERSON") @map("price_basis_snapshot") @db.VarChar(20)
  quotedUnitPriceCents Int? @map("quoted_unit_price_cents")
  requiredStaffCountSnapshot Int @default(1) @map("required_staff_count_snapshot")
  assignedTherapistId BigInt? @map("assigned_therapist_id")
  therapistSelectionMode String @default("LEGACY_UNKNOWN") @map("therapist_selection_mode") @db.VarChar(20)
  requestedTherapistIds Json? @map("requested_therapist_ids")
  serviceNameSnapshot String @map("service_name_snapshot") @db.VarChar(200)
  durationKindSnapshot String @default("TIMED") @map("duration_kind_snapshot") @db.VarChar(20)
  variantNameSnapshot String? @map("variant_name_snapshot") @db.VarChar(100)
  roomTypeSnapshot String? @map("room_type_snapshot") @db.VarChar(20)
  durationMin Int @map("duration_min")
  staffBufferMin Int @map("staff_buffer_min")
  roomBufferMin Int @map("room_buffer_min")
  priceCentsSnapshot Int @map("price_cents_snapshot")
  currency String @db.VarChar(3)
  assignedRoomId BigInt? @map("assigned_room_id")
  startAtUtc DateTime @map("start_at_utc")
  endAtUtc DateTime @map("end_at_utc")
  createdAt DateTime @default(now()) @map("created_at")
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  service ShopService @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  variant ShopServiceVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)
  assignedRoom ShopRoom? @relation(fields: [assignedRoomId], references: [id], onDelete: Restrict)
  assignedTherapist Therapist? @relation("AssignedItemTherapist", fields: [assignedTherapistId], references: [id], onDelete: Restrict)
  resourceLocks BookingResourceLock[]
  addOns BookingAddOn[]
  @@unique([bookingId, participantIndex, sequence], map: "booking_items_participant_sequence_key")
  @@index([serviceId], map: "booking_items_service_idx")
  @@index([variantId], map: "booking_items_variant_idx")
  @@index([assignedRoomId], map: "booking_items_room_idx")
  @@index([assignedTherapistId], map: "booking_items_assigned_therapist_idx")
  @@map("booking_items")
}

model BookingResourceLock {
  id BigInt @id @default(autoincrement())
  bookingId BigInt @map("booking_id")
  bookingItemId BigInt? @map("booking_item_id")
  shopId BigInt @map("shop_id")
  resourceType String @map("resource_type") @db.VarChar(20)
  resourceId BigInt @map("resource_id")
  startAtUtc DateTime @map("start_at_utc")
  endAtUtc DateTime @map("end_at_utc")
  status String @default("ACTIVE") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  bookingItem BookingItem? @relation(fields: [bookingItemId], references: [id], onDelete: Restrict)
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Restrict)
  @@index([shopId, resourceType, status, startAtUtc, endAtUtc], map: "booking_resources_overlap_idx")
  @@index([resourceType, resourceId, status, startAtUtc, endAtUtc], map: "booking_resource_window_idx")
  @@index([bookingId, status], map: "booking_resources_booking_idx")
  @@index([bookingItemId], map: "booking_resources_item_idx")
  @@map("booking_resource_locks")
}

model ShopStaffGrant {
  id BigInt @id @default(autoincrement())
  shopId BigInt @map("shop_id")
  userId BigInt @map("user_id")
  createdById BigInt @map("created_by_id")
  permissions Json
  status String @default("ACTIVE") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  revokedAt DateTime? @map("revoked_at")
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Restrict)
  user User @relation("StaffUser", fields: [userId], references: [id], onDelete: Restrict)
  createdBy User @relation("StaffGrantCreator", fields: [createdById], references: [id], onDelete: Restrict)
  @@unique([shopId, userId])
  @@index([userId, status])
  @@index([createdById])
  @@map("shop_staff_grants")
}

// Login identity is independent of the historical financial/operating owner.
// No legacy owner-to-shop binding is inferred by migration.
model ShopLoginBinding {
  id BigInt @id @default(autoincrement())
  shopId BigInt @unique @map("shop_id")
  userId BigInt @unique @map("user_id")
  createdById BigInt @map("created_by_id")
  reason String @db.VarChar(1000)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user User @relation("ShopLoginAccount", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy User @relation("ShopLoginBindingCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@index([createdById])
  @@map("shop_login_bindings")
}

// Directed, company-configured access. No transitive grants or owner powers.
model ShopAccountGrant {
  id BigInt @id @default(autoincrement())
  sourceShopId BigInt @map("source_shop_id")
  targetShopId BigInt @map("target_shop_id")
  permissions Json
  status String @default("ACTIVE") @db.VarChar(20)
  createdById BigInt @map("created_by_id")
  updatedById BigInt @map("updated_by_id")
  reason String @db.VarChar(1000)
  revokedById BigInt? @map("revoked_by_id")
  revokedReason String? @map("revoked_reason") @db.VarChar(1000)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  revokedAt DateTime? @map("revoked_at") @db.DateTime(3)
  sourceShop Shop @relation("AccountGrantSource", fields: [sourceShopId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  targetShop Shop @relation("AccountGrantTarget", fields: [targetShopId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy User @relation("AccountGrantCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  updatedBy User @relation("AccountGrantUpdater", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  revokedBy User? @relation("AccountGrantRevoker", fields: [revokedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@unique([sourceShopId, targetShopId])
  @@index([targetShopId, status])
  @@index([sourceShopId, status])
  @@index([createdById])
  @@index([updatedById])
  @@index([revokedById])
  @@map("shop_account_grants")
}

// Add to User: notificationJobs NotificationOutbox[]; notifications UserNotification[]; notificationPreference NotificationPreference?
model NotificationOutbox {
  id String @id @db.Char(36)
  eventKey String @map("event_key") @db.VarChar(160)
  contentHash String @map("content_hash") @db.Char(64)
  userId BigInt? @map("user_id")
  topic String @db.VarChar(40)
  resourceType String @map("resource_type") @db.VarChar(30)
  resourceId String @map("resource_id") @db.VarChar(100)
  bookingId BigInt? @map("booking_id")
  expectedStartAtUtc DateTime? @map("expected_start_at_utc") @db.DateTime(3)
  channel String @db.VarChar(10)
  status String @default("PENDING") @db.VarChar(16)
  runAt DateTime @map("run_at") @db.DateTime(3)
  attempts Int @default(0)
  retryCount Int @default(0) @map("retry_count")
  maxAttempts Int @default(5) @map("max_attempts")
  leaseToken String? @map("lease_token") @db.Char(36)
  leaseUntil DateTime? @map("lease_until") @db.DateTime(3)
  lastErrorCode String? @map("last_error_code") @db.VarChar(64)
  acceptedCount Int @default(0) @map("accepted_count")
  dataJson Json @map("data_json")
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  finishedAt DateTime? @map("finished_at") @db.DateTime(3)
  user User? @relation(fields:[userId], references:[id], onDelete: Cascade)
  notification UserNotification?
  @@unique([eventKey,channel])
  @@index([status,runAt])
  @@index([bookingId,topic,status])
  @@map("notification_outbox")
}

model UserNotification {
  id String @id @db.Char(36)
  outboxId String @unique @map("outbox_id") @db.Char(36)
  userId BigInt @map("user_id")
  topic String @db.VarChar(40)
  title String @db.VarChar(200)
  body String @db.VarChar(1000)
  resourceType String @map("resource_type") @db.VarChar(30)
  resourceId String @map("resource_id") @db.VarChar(100)
  bookingId BigInt? @map("booking_id")
  readAt DateTime? @map("read_at") @db.DateTime(3)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  user User @relation(fields:[userId], references:[id], onDelete: Cascade)
  outbox NotificationOutbox @relation(fields:[outboxId],references:[id],onDelete:Cascade)
  @@index([userId,createdAt,id])
  @@index([userId,readAt])
  @@map("user_notifications")
}

model NotificationPreference {
  userId BigInt @id @map("user_id")
  pushEnabled Boolean @default(false) @map("push_enabled")
  pushConsentedAt DateTime? @map("push_consented_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@map("notification_preferences")
}

// Sales are opt-in per shop. Missing policy never enables collection.
model ShopGiftSalesPolicy {
  shopId BigInt @id @map("shop_id")
  payAtStoreEnabled Boolean @default(false) @map("pay_at_store_enabled")
  updatedAt DateTime @updatedAt @map("updated_at")
  shop Shop @relation(fields:[shopId],references:[id],onDelete:Restrict)
  @@map("shop_gift_sales_policies")
}

// Full offline receipt/refund evidence is append-only; never a provider settlement.
model GiftCardSaleEntry {
  id String @id @default(uuid()) @db.Char(36)
  orderId BigInt @map("order_id")
  operatorId BigInt @map("operator_id")
  kind String @db.VarChar(10)
  amountCents Int @map("amount_cents")
  method String @db.VarChar(20)
  reference String? @db.VarChar(100)
  reason String @db.VarChar(500)
  requestKey String @unique @map("request_key") @db.Char(64)
  requestHash String @map("request_hash") @db.Char(64)
  createdAt DateTime @default(now()) @map("created_at")
  order GiftCardOrder @relation(fields:[orderId],references:[id],onDelete:Restrict)
  operator User @relation(fields:[operatorId],references:[id],onDelete:Restrict)
  @@unique([orderId,kind])
  @@index([operatorId])
  @@map("gift_card_sale_entries")
}

// Independent preservation area only. No live User/Shop/Booking/Payment relations.
model LegacyStagingBatch {
  id String @id @db.Char(64)
  singleton Int @unique @default(1)
  planDigest String @map("plan_digest") @db.Char(64)
  sourceSystem String @map("source_system") @db.VarChar(32)
  datasetKind String @map("dataset_kind") @db.VarChar(20)
  summary Json
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  entities LegacyStagingEntity[]
  @@map("legacy_staging_batches")
}

model LegacyStagingEntity {
  id String @id @db.Char(64)
  batchId String @map("batch_id") @db.Char(64)
  sourceSystem String @map("source_system") @db.VarChar(32)
  sourceTable String @map("source_table") @db.VarChar(63)
  sourceId String @map("source_id") @db.VarChar(128)
  kind String @db.VarChar(32)
  shopKey String? @map("shop_key") @db.Char(64)
  payload Json
  payloadDigest String @map("payload_digest") @db.Char(64)
  batch LegacyStagingBatch @relation(fields:[batchId],references:[id],onDelete:Restrict)
  @@unique([sourceSystem,sourceTable,sourceId], map:"legacy_staging_source_identity")
  @@index([batchId,kind], map:"legacy_staging_batch_kind_idx")
  @@index([shopKey,kind], map:"legacy_staging_shop_kind_idx")
  @@map("legacy_staging_entities")
}


model MediaAsset {
  id String @id @db.Char(36)
  ownerId BigInt @map("owner_id")
  shopId BigInt? @map("shop_id")
  shopOwnerId BigInt? @map("shop_owner_id")
  scope String @db.VarChar(10)
  purpose String @db.VarChar(10)
  status String @db.VarChar(16)
  requestKey String @map("request_key") @db.VarChar(80)
  inputHash String @map("input_hash") @db.Char(64)
  contentHash String @map("content_hash") @db.Char(64)
  storageNamespace String @map("storage_namespace") @db.Char(64)
  storageDriver String @map("storage_driver") @db.VarChar(10)
  objectKey String @unique @map("object_key") @db.VarChar(100)
  mimeType String @map("mime_type") @db.VarChar(30)
  sizeBytes Int @map("size_bytes")
  width Int
  height Int
  expiresAt DateTime @map("expires_at") @db.DateTime(3)
  boundAt DateTime? @map("bound_at") @db.DateTime(3)
  leaseToken String? @map("lease_token") @db.Char(36)
  lastErrorCode String? @map("last_error_code") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  owner User @relation("MediaUploader",fields:[ownerId],references:[id],onDelete:Restrict,onUpdate:Restrict)
  shop Shop? @relation(fields:[shopId],references:[id],onDelete:Restrict,onUpdate:Restrict)
  @@unique([ownerId,requestKey])
  @@index([status,expiresAt])
  @@index([shopId,status])
  @@map("media_assets")
}

model AuthProviderIdentity {
  id String @id @default(uuid()) @db.VarChar(36)
  userId BigInt @map("user_id")
  provider String @db.VarChar(10)
  subject String @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@unique([provider,subject])
  @@index([userId])
  @@map("auth_provider_identities")
}
model SocialLoginChallenge {
  id String @id @default(uuid()) @db.VarChar(36)
  provider String @db.VarChar(10)
  nonceHash String @map("nonce_hash") @db.VarChar(64)
  expiresAt DateTime @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt DateTime @default(now()) @map("created_at")
  @@index([expiresAt])
  @@map("social_login_challenges")
}
model EmailLoginChallenge {
  id String @id @default(uuid()) @db.VarChar(36)
  email String @db.VarChar(255)
  codeHash String @map("code_hash") @db.VarChar(64)
  deliveryState String @default("PENDING") @map("delivery_state") @db.VarChar(20)
  attempts Int @default(0)
  expiresAt DateTime @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt DateTime @default(now()) @map("created_at")
  @@index([email,createdAt])
  @@index([expiresAt])
  @@map("email_login_challenges")
}
model EmailLoginThrottle {
  email String @id @db.VarChar(255)
  lastSentAt DateTime @map("last_sent_at")
  windowStart DateTime @map("window_start")
  sendCount Int @map("send_count")
  @@map("email_login_throttles")
}

// Separate purpose and credential snapshot: ordinary sign-in proof cannot reset a password.
model EmailPasswordRecoveryChallenge {
  id String @id @default(uuid()) @db.VarChar(36)
  userId BigInt @map("user_id")
  email String @db.VarChar(255)
  credentialHash String @map("credential_hash") @db.Char(64)
  codeHash String @map("code_hash") @db.Char(64)
  deliveryState String @default("PENDING") @map("delivery_state") @db.VarChar(20)
  attempts Int @default(0)
  expiresAt DateTime @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt DateTime @default(now()) @map("created_at")
  @@index([userId,createdAt])
  @@index([expiresAt])
  @@map("email_password_recovery_challenges")
}

model CopyConfigOperation {
  id String @id @db.VarChar(36)
  actorId BigInt @map("actor_id")
  sourceShopId BigInt @map("source_shop_id")
  targetShopId BigInt @map("target_shop_id")
  kind String @db.VarChar(20)
  idempotencyKey String @map("idempotency_key") @db.VarChar(100)
  requestHash String @map("request_hash") @db.Char(64)
  result Json
  createdAt DateTime @default(now()) @map("created_at")
  @@unique([actorId,idempotencyKey],map:"copy_config_actor_key")
  @@index([targetShopId,createdAt],map:"copy_config_target_created_idx")
  @@map("copy_config_operations")
}

// Atomic catalog append receipts, scoped to the authenticated actor and shop.
// Contains IDs and result versions only, never raw input or contact information.
model CatalogMutationOperation {
  id String @id @db.VarChar(36)
  actorId BigInt @map("actor_id")
  shopId BigInt @map("shop_id")
  action String @db.VarChar(32)
  idempotencyKey String @map("idempotency_key") @db.VarChar(100)
  requestHash String @map("request_hash") @db.Char(64)
  result Json
  createdAt DateTime @default(now()) @map("created_at")
  @@unique([actorId,idempotencyKey],map:"catalog_mutation_actor_key")
  @@index([shopId,createdAt],map:"catalog_mutation_shop_created_idx")
  @@map("catalog_mutation_operations")
}

// Immutable evidence of company-created login bindings. No raw request,
// password, contact snapshot or authentication secret is retained here.
model AccountProvisionOperation {
  id String @id @db.VarChar(36)
  actorId BigInt @map("actor_id")
  shopId BigInt @map("shop_id")
  userId BigInt @map("user_id")
  idempotencyKey String @map("idempotency_key") @db.VarChar(100)
  requestHash String @map("request_hash") @db.Char(64)
  status String @default("APPLIED") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")
  actor User @relation("AccountProvisionActor",fields:[actorId],references:[id],onDelete:Restrict,onUpdate:Restrict)
  shop Shop @relation(fields:[shopId],references:[id],onDelete:Restrict,onUpdate:Restrict)
  user User @relation("AccountProvisionUser",fields:[userId],references:[id],onDelete:Restrict,onUpdate:Restrict)
  @@unique([actorId,idempotencyKey],map:"account_provision_actor_key")
  @@index([shopId,createdAt],map:"account_provision_shop_created_idx")
  @@index([userId],map:"account_provision_user_idx")
  @@map("account_provision_operations")
}

// Atomic command evidence only: no customer contact, password or raw payload.
model BookingOperationReceipt {
  id String @id @db.VarChar(36)
  actorId BigInt @map("actor_id")
  bookingId BigInt @map("booking_id")
  shopId BigInt @map("shop_id")
  requestKey String @map("request_key") @db.VarChar(100)
  action String? @db.VarChar(40)
  requestHash String? @map("request_hash") @db.Char(64)
  outcome String @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")
  @@unique([actorId,bookingId,requestKey],map:"booking_operation_actor_booking_key")
  @@index([shopId,createdAt],map:"booking_operation_shop_created_idx")
  @@map("booking_operation_receipts")
}
