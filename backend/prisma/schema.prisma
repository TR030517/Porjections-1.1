model SensitiveWord {
  id        BigInt   @id @default(autoincrement())
  word      String   @unique @db.VarChar(200)
  category  String   @default("DEFAULT") @db.VarChar(20) // DANGER | POLITICAL | AD | SPAM | DEFAULT
  severity  String   @default("HIGH") @db.VarChar(10)
  isActive  Boolean  @default(true) @map("is_active")
  createdBy BigInt?  @map("created_by")
