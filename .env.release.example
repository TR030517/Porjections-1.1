# Copy to .env.release. Keep secrets out of Git. Use hex passwords to avoid URL escaping.
RELEASE_TAG=2.0.0-rc14
SITE_ADDRESS=booking.example.com
PUBLIC_ORIGIN=https://booking.example.com
TLS_EMAIL=ops@example.com
MYSQL_DATABASE=massajoy2
MYSQL_ROOT_PASSWORD=REPLACE_WITH_UNIQUE_RANDOM_HEX
MYSQL_PASSWORD=REPLACE_WITH_UNIQUE_RANDOM_HEX
JWT_SECRET=REPLACE_WITH_UNIQUE_RANDOM_HEX_AT_LEAST_64_CHARACTERS
# Generate once for a NEW vault: canonical base64 of 32 cryptographically random bytes.
# Preserve it across releases. Existing vaults MUST use their original key, never a new one.
# Compose fixes DIR=/app/.local/store-account-credentials/vault and persists its parent volume.
MERCHANT_CREDENTIAL_VAULT_KEY=REPLACE_WITH_EXISTING_OR_NEW_VAULT_BASE64_32_BYTE_KEY
PAYMENT_PROVIDER=disabled
PAYMENT_EXTERNAL_ENABLED=false
PLATFORM_FEE_BPS=0
# Online prepayment holds only; existing legacy reservations keep their original policy.
BOOKING_HOLD_MINUTES=15
# Set only after approving the customer refund policy; missing values keep external payment disabled.
REFUND_POLICY_FULL_HOURS=
REFUND_POLICY_PARTIAL_PERCENT=

# Optional Square Hosted Checkout. Start with sandbox; keep external calls disabled until configured.
SQUARE_ENVIRONMENT=sandbox
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_MERCHANT_ID=
# Bind this single Square account to one verified 2.0 shop ID; never leave it shared across shops.
SQUARE_SHOP_ID=
SQUARE_CURRENCY=USD
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_NOTIFICATION_URL=https://booking.example.com/api/v1/payments/square/webhook
SQUARE_CHECKOUT_REDIRECT_URL=https://booking.example.com/

# Optional S3-compatible avatar upload. Unconfigured uploads return 503.
S3_REGION=us-east-1
S3_BUCKET=
S3_PUBLIC_URL=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Managed image uploads: disabled | local | s3. Local Docker storage is /app/media.
MEDIA_STORAGE_DRIVER=disabled
# Standalone backend local driver requires an absolute dedicated persistent directory.
MEDIA_LOCAL_DIR=

# Customer quick sign-in; no provider secrets are sent to the browser.
AUTH_GOOGLE_CLIENT_IDS=
AUTH_GOOGLE_WEB_CLIENT_ID=
AUTH_APPLE_CLIENT_IDS=
AUTH_APPLE_WEB_CLIENT_ID=
AUTH_APPLE_WEB_REDIRECT_URI=
AUTH_EMAIL_PROVIDER=
AUTH_EMAIL_API_KEY=
AUTH_EMAIL_FROM=
# Development only; production always forbids returning email verification codes.
AUTH_EMAIL_LOCAL_OTP=false

# Order mail requires a configured sender and worker; accepted is not delivered.
BOOKING_ONLINE_PAYMENT_ENABLED=false
ORDER_EMAIL_ENABLED=false
ORDER_EMAIL_PROVIDER=resend
ORDER_EMAIL_API_KEY=
ORDER_EMAIL_FROM=
NOTIFICATION_WORKER_ENABLED=true
